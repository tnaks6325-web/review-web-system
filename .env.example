# ══════════════════════════════════════════════
# 리뷰웹시스템 환경변수 (.env)
# ══════════════════════════════════════════════

# ══════════════════════════════════════════════
# DATABASE (필수)
# ══════════════════════════════════════════════
# 로컬 개발:
DATABASE_URL=postgresql://user:password@localhost:5432/review_system
# Railway: 프로젝트에 Postgres 플러그인 추가 → 자동 주입됨
# Railway 수동 설정 시: ${{Postgres.DATABASE_URL}}

# ══════════════════════════════════════════════
# JWT 인증 (필수)
# ══════════════════════════════════════════════
JWT_SECRET=your-super-secret-key-min-32chars
JWT_EXPIRES_IN=8h

# ══════════════════════════════════════════════
# ADMIN 마스터 계정 (필수)
# ══════════════════════════════════════════════
MASTER_ADMIN_NAME=master
MASTER_ADMIN_PW=931118

# ══════════════════════════════════════════════
# GOOGLE APIs - Service Account (필수)
# ══════════════════════════════════════════════
# 방법 1: 이메일 + 키 직접 설정 (Railway 권장)
GOOGLE_SERVICE_ACCOUNT_EMAIL=review-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# 방법 2: JSON 파일 경로 (로컬 개발용)
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# ══════════════════════════════════════════════
# GOOGLE SHEETS / DRIVE (필수)
# ══════════════════════════════════════════════
BASE_SHEET_ID=1YW2KgPo-fvwBUS1nuzWTutqE_n2RVAnHPXXYVn4o2i4
DRIVE_ROOT_FOLDER_ID=1afBtCDYs-A-LenIKhsiKJWvkuFmUYV8d
AI_REVIEW_FOLDER_ID=  # 새 통합 루트 폴더 (AI_REVIEW_FOLDER). DRIVE_ROOT_FOLDER_ID보다 우선

# ══════════════════════════════════════════════
# 서버 설정
# ══════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# 리뷰어 주문캡처 ↔ 참여명의 서버 강제검증 (프론트/DB 마이그레이션 배포 확인 후 활성화)
REVIEWER_CAPTURE_IDENTITY_ENABLED=false
# 리뷰어 전용 서명 세션 수명(기본 12h)
REVIEWER_SESSION_EXPIRES_IN=12h

# CORS 허용 오리진 (쉼표 구분)
# Cloudflare Pages URL + 커스텀 도메인 추가
ALLOWED_ORIGINS=https://your-project.pages.dev,https://yourdomain.com

# ══════════════════════════════════════════════
# 인덱스 빌드 스케줄러 (선택)
# ══════════════════════════════════════════════
INDEX_CRON_SCHEDULE=0 9-19 * * 1-6
INDEX_FULL_REBUILD_INTERVAL_H=6

# ══════════════════════════════════════════════
# 리뷰 미작성 카카오 알림톡 (SOLAPI, 기본 OFF)
# ══════════════════════════════════════════════
# 운영 전 API 키·채널 ID·승인된 템플릿 ID 3개·등록 발신번호를 Railway 변수로 넣는다.
# Secret은 저장소나 로그에 기록하지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_SENDER_NUMBER=
SOLAPI_REVIEW_TEMPLATE_ID_1=
SOLAPI_REVIEW_TEMPLATE_ID_2=
SOLAPI_REVIEW_TEMPLATE_ID_3=

# 모든 값과 dry-run 결과를 확인한 뒤에만 1로 전환한다.
REVIEW_REMINDER_ENABLED=0
REVIEW_REMINDER_LINK=review-web-system.pages.dev/search.html
REVIEW_REMINDER_CRON_SCHEDULE=0 10-18 * * *
# 0 = 리뷰마감일 종료 뒤 1차, 이후 성공 수신 기준 24시간 간격, 3차 뒤 다음날까지 유예
REVIEW_REMINDER_FIRST_OFFSET_DAYS=0
REVIEW_REMINDER_INTERVAL_HOURS=24
REVIEW_REMINDER_FINAL_GRACE_DAYS=1
REVIEW_REMINDER_RETRY_HOURS=6
# 현재 SOLAPI 일 50건 한도보다 낮은 기본 안전 상한
REVIEW_REMINDER_DAILY_CAP=40
REVIEW_REMINDER_CYCLE_LIMIT=40

# ══════════════════════════════════════════════
# 이상로그(비정상 로그) (선택)
# ══════════════════════════════════════════════
# 비정상 이벤트 기록 on/off (기본 on, 'false' 로 끔)
ERRORLOG_ENABLED=true
# 해결건 보존 일수 (미해결건은 3배 기간 후 삭제). 기본 30
ERRORLOG_RETENTION_DAYS=30
# 미분류(unknown) 에러만 Gemini 로 자연어 한 문장 보강 (기본 off, GEMINI_API_KEY 필요)
ERRORLOG_AI_ENRICH=false

# ══════════════════════════════════════════════
# Railway 배포 체크리스트
# ══════════════════════════════════════════════
# 1. Railway 프로젝트 생성 후 GitHub 연결 (server/ 디렉토리)
# 2. Postgres 플러그인 추가 (DATABASE_URL 자동 주입)
# 3. 환경변수 설정:
#    - JWT_SECRET (강력한 랜덤 문자열 32자 이상)
#    - MASTER_ADMIN_NAME, MASTER_ADMIN_PW
#    - GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_PRIVATE_KEY
#    - BASE_SHEET_ID, DRIVE_ROOT_FOLDER_ID
#    - ALLOWED_ORIGINS (Cloudflare Pages URL)
#    - NODE_ENV=production
# 4. 최초 배포 후 마이그레이션:
#    railway run -- npm run migrate
#    railway run -- npm run migrate:detail
#    railway run -- npm run migrate:reviewers
