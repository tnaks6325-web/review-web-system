# ══════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/review_system
# Railway 사용 시: ${{Postgres.DATABASE_URL}} 자동 주입

# ══════════════════════════════════════════════
# JWT 인증
# ══════════════════════════════════════════════
JWT_SECRET=your-super-secret-key-min-32chars
JWT_EXPIRES_IN=8h

# ══════════════════════════════════════════════
# ADMIN 초기 설정
# ══════════════════════════════════════════════
MASTER_ADMIN_NAME=master
MASTER_ADMIN_PW=931118

# ══════════════════════════════════════════════
# GOOGLE APIs (Service Account)
# ══════════════════════════════════════════════
GOOGLE_SERVICE_ACCOUNT_EMAIL=review-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/secrets/service-account.json

# ══════════════════════════════════════════════
# GOOGLE SHEETS / DRIVE 설정
# ══════════════════════════════════════════════
BASE_SHEET_ID=1YW2KgPo-fvwBUS1nuzWTutqE_n2RVAnHPXXYVn4o2i4
DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# ══════════════════════════════════════════════
# 서버 설정
# ══════════════════════════════════════════════
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-domain.pages.dev,https://yourdomain.com

# ══════════════════════════════════════════════
# 인덱스 빌드 스케줄 (cron 표현식)
# ══════════════════════════════════════════════
INDEX_CRON_SCHEDULE="0 9-19 * * 1-6"
INDEX_FULL_REBUILD_INTERVAL_H=6

# ══════════════════════════════════════════════
# 캐시 (선택: Redis 사용 시)
# ══════════════════════════════════════════════
# REDIS_URL=redis://default:password@host:6379
